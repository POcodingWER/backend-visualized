# EC2의 deploy/production.env 로 복사해서 채우세요:  cp deploy/production.env.example deploy/production.env
# 이 파일(.example)에는 실제 비밀값을 넣지 마세요. production.env 는 .gitignore 대상입니다.

# ── compose 프로필: 같은 EC2의 MySQL 컨테이너를 쓰면 주석 해제 (매번 --profile local-db 를 안 붙여도 됨) ──
# COMPOSE_PROFILES=local-db

# ── 도메인 / HTTPS (Caddy) ──
# 도메인이 아직 없으면 sslip.io로 바로 HTTPS 가능: EC2 IP 1.2.3.4 → 1-2-3-4.sslip.io
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# ── CORS: 허용 출처 (경로 없이, 여러 개면 쉼표). 실제 값 = WEB_ORIGIN + ,VERCEL_ORIGIN (비어 있으면 생략) ──
WEB_ORIGIN=http://localhost:3000
# Vercel 배포 후 그 주소를 넣고 ./deploy/compose.sh up -d
VERCEL_ORIGIN=https://backend-visualized.vercel.app

# ── 데이터베이스: 둘 중 하나 ──
# (A) RDS
DATABASE_URL=mysql://app:CHANGE_ME@your-db.xxxxxxxx.ap-northeast-2.rds.amazonaws.com:3306/backend_visualized
# (B) 같은 EC2의 MySQL 컨테이너 (--profile local-db). 아래 MYSQL_* 와 비밀번호를 맞추세요.
# DATABASE_URL=mysql://app:CHANGE_ME@mysql:3306/backend_visualized
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=backend_visualized
MYSQL_USER=app
MYSQL_PASSWORD=

# ── Redis (6장 캐시): docker-compose.prod.yml의 redis 컨테이너. ElastiCache를 쓰면 그 주소(rediss://…)로
REDIS_URL=redis://redis:6379/0

# ── 비밀값 (openssl rand -base64 48 로 생성) ──
JWT_ACCESS_SECRET=
# 비우면 운영에서 /events/admin/* 비활성화
ADMIN_API_KEY=

# ── 리프레시 쿠키 ──
# *.vercel.app ↔ api.example.com 은 서로 다른 사이트 → None (기본값). 웹도 app.example.com 처럼 같은 도메인을 쓰면 lax 권장
REFRESH_COOKIE_SAME_SITE=none

# ── 데모 기능 ──
# 공개 데모 사이트라 토큰 탈취 시뮬레이션을 켬 (실서비스면 false)
AUTH_DEMO_ENDPOINTS=true

# ── 남용 방지 (기본값이면 생략 가능) ──
# MAX_BODY_SIZE=200kb
# EVENTS_GLOBAL_LIMIT_PER_MINUTE=30000
# RATE_LIMIT_DEMO_GLOBAL_LIMIT_PER_MINUTE=20000
# MAX_STREAM_CONNECTIONS=200
# AGGREGATION_DEMO_COOLDOWN_MS=10000
# SIMULATION_COOLDOWN_MS=3000

# ── DB 백업 (deploy/backup-mysql.sh, 매일 04:00 KST) ──
# 서버 밖(S3)에도 한 부 올리려면 버킷 이름을 넣는다. 비우면 서버 디스크(backups/)에만 7일 보관
# 인스턴스 역할(backend-visualized-ec2-ssm)에 s3:PutObject 권한이 있어야 함 → docs/deploy.md 「DB 백업과 복원」
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=mysql
