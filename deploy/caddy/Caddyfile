# API_DOMAIN(예: api.example.com)의 DNS A 레코드가 이 EC2의 Elastic IP를 가리키면
# Caddy가 Let's Encrypt 인증서를 자동으로 발급·갱신한다 (80, 443 포트가 열려 있어야 함).
# 이 폴더(deploy/caddy) 전체가 컨테이너의 /etc/caddy 로 마운트된다.
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	# 지금 서비스 중인 API 색(api_blue_1/2 또는 api_green_1/2)으로 보내는 reverse_proxy 설정.
	# deploy/deploy.sh가 이 파일을 새 색으로 다시 쓰고 `caddy reload` 한다 (git 미추적, 서버에서 생성).
	# 7장: 2개 인스턴스에 로드 밸런싱 (least_conn + health check)
	import /etc/caddy/upstream.caddy

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format console
	}
}
