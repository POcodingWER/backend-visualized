generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Event {
  id         BigInt   @id @default(autoincrement())
  name       String   @db.VarChar(100)
  properties Json
  sessionId  String   @db.VarChar(64)
  createdAt  DateTime @default(now()) @db.DateTime(3)

  @@index([name, createdAt])
}

/// 일 단위 집계 (KST 날짜 기준). 집계 잡이 Event에서 upsert.
model EventDailyStat {
  id             Int      @id @default(autoincrement())
  date           DateTime @db.Date
  name           String   @db.VarChar(100)
  count          Int
  uniqueSessions Int
  updatedAt      DateTime @updatedAt @db.DateTime(3)

  @@unique([date, name])
  @@index([date])
}

/// 1장 티켓팅: 선착순 쿠폰. issuedCount는 "카운터", 실제 발급 건수는 CouponIssue 행 수.
/// version은 낙관적 락용.
model Coupon {
  id            Int           @id @default(autoincrement())
  name          String        @unique @db.VarChar(50)
  totalQuantity Int
  issuedCount   Int           @default(0)
  version       Int           @default(0)
  updatedAt     DateTime      @updatedAt @db.DateTime(3)
  issues        CouponIssue[]
}

/// 발급 내역. 'none' 전략의 초과 발급을 그대로 관찰하려고 (couponId, userId) unique는 걸지 않음.
model CouponIssue {
  id        BigInt   @id @default(autoincrement())
  couponId  Int
  userId    String   @db.VarChar(64)
  strategy  String   @db.VarChar(16)
  createdAt DateTime @default(now()) @db.DateTime(3)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId, createdAt])
}

/// 2장 손목밴드: 인증 토큰 데모용 사용자 (서버 시작 시 데모 계정 upsert)
model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique @db.VarChar(50)
  displayName   String         @db.VarChar(100)
  /// scrypt: salt:hash (hex)
  passwordHash  String         @db.VarChar(255)
  createdAt     DateTime       @default(now()) @db.DateTime(3)
  refreshTokens RefreshToken[]
}

enum RefreshTokenStatus {
  active
  used
  revoked
}

/// 리프레시 토큰은 원문 대신 SHA-256 해시만 저장. 같은 로그인에서 회전된 토큰들은 같은 familyId.
model RefreshToken {
  id            String             @id @db.Char(36)
  userId        Int
  familyId      String             @db.Char(36)
  /// 바로 이전 토큰 (회전 체인)
  parentId      String?            @db.Char(36)
  tokenHash     String             @unique @db.Char(64)
  status        RefreshTokenStatus @default(active)
  revokedReason String?            @db.VarChar(50)
  createdAt     DateTime           @default(now()) @db.DateTime(3)
  usedAt        DateTime?          @db.DateTime(3)
  revokedAt     DateTime?          @db.DateTime(3)
  expiresAt     DateTime           @db.DateTime(3)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
  @@index([userId])
}

/// 4장: 포인트 지갑. balance는 "잔액 숫자 하나" — 덮어쓰기 방식은 이 칸만 고친다.
model PointWallet {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(64)
  balance   Int
  updatedAt DateTime @updatedAt @db.DateTime(3)
}

/// 4장: 입출금 내역 (추가만 하고 고치지 않음). 올바른 잔액 = SUM(amount).
model PointEntry {
  id         BigInt   @id @default(autoincrement())
  walletName String   @db.VarChar(64)
  amount     Int
  reason     String   @db.VarChar(32)
  createdAt  DateTime @default(now()) @db.DateTime(3)

  @@index([walletName, id])
}

/// 5장: 결제. 같은 idempotencyKey는 unique 제약 때문에 한 행만 생긴다 (키 없는 결제는 NULL이라 여러 행 가능).
model Payment {
  id             Int       @id @default(autoincrement())
  orderId        String    @db.VarChar(64)
  amount         Int
  /// processing → paid
  status         String    @db.VarChar(16)
  idempotencyKey String?   @unique @db.VarChar(64)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  paidAt         DateTime? @db.DateTime(3)

  @@index([orderId])
}

/// 6장: 맛집 대기판 (캐시할 원본 데이터).
model MenuBoard {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(64)
  content   String   @db.VarChar(200)
  version   Int
  updatedAt DateTime @updatedAt @db.DateTime(3)
}
