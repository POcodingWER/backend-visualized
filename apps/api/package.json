{
  "name": "@bv/api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "rm -rf dist-test && tsc -p tsconfig.spec.json && node --test dist-test/**/*.spec.js",
    "bench": "tsx --env-file=.env scripts/bench-ingest.ts",
    "bench:coupon": "tsx --env-file=.env scripts/bench-coupon.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "prisma": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@bv/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.10",
    "tsc-watch": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
