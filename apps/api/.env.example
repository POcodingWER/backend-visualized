PORT=4000
DATABASE_URL="mysql://root:root_password@localhost:3307/backend_visualized"
WEB_ORIGIN=http://localhost:3000
# 6장 캐시 데모: docker compose up -d redis (bv-redis, 6380). 생략하면 이 값이 기본
REDIS_URL=redis://127.0.0.1:6380/0
# Stage 3 auth demo (dev 기본값이 있으므로 선택)
JWT_ACCESS_SECRET=change-me-in-production
AUTH_ACCESS_TOKEN_TTL_SECONDS=20
AUTH_REFRESH_TOKEN_TTL_SECONDS=86400
# 토큰 탈취 시뮬레이션 등 데모 전용 엔드포인트 (운영에선 false)
AUTH_DEMO_ENDPOINTS=true
# 관리자 API(/admin/*) 키. 개발에선 비워두면 키 없이 허용 (운영 설정은 docs/deploy.md)
ADMIN_API_KEY=
