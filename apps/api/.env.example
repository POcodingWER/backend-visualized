PORT=4000
# 로컬 MySQL(3306). docker compose up -d mysql 을 쓰면 mysql://root:root_password@localhost:3307/backend_visualized
DATABASE_URL="mysql://root:<비밀번호>@localhost:3306/backend_visualized"
WEB_ORIGIN=http://localhost:3000
# 6장 캐시 데모: docker compose up -d redis (bv-redis, 6380). 생략하면 이 값이 기본
REDIS_URL=redis://127.0.0.1:6380/0
# 2장 손목밴드(인증) 데모 (dev 기본값이 있으므로 선택)
JWT_ACCESS_SECRET=change-me-in-production
AUTH_ACCESS_TOKEN_TTL_SECONDS=20
AUTH_REFRESH_TOKEN_TTL_SECONDS=86400
# 토큰 탈취 시뮬레이션 등 데모 전용 엔드포인트 (운영에선 false)
AUTH_DEMO_ENDPOINTS=true
# 1·4·6장 시뮬레이션 공용 쿨다운(ms, 기본 3000)
# SIMULATION_COOLDOWN_MS=3000
# 관리자 API(/events/admin/*) 키. 개발에선 비워두면 키 없이 허용 (운영 설정은 docs/deploy.md)
ADMIN_API_KEY=
# 선택: Sentry 오류 전송. 비우면 꺼짐
SENTRY_DSN=
